+    justifyContent: "center",
+    paddingVertical: 13,
+    borderRadius: radius.sm,
+    elevation: 4,
+    ...(Platform.OS === "web"
+      ? ({ boxShadow: "0px 4px 6px rgba(0, 136, 204, 0.3)" } as any)
+      : {
+          ...shadow({ color: "#0088cc", opacity: 0.3, radius: 6, offsetY: 4 }),
+        }),
+  },
+  tgButtonTxt: {
+    color: "#FFFFFF",
